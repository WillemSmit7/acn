# Firestore emulator (leave set for local development).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=acn-local


# How long collected lines are buffered before being written as one batch.
LAYER_ZERO_FLUSH_INTERVAL_MS=500

# Delay before re-attaching a tail process that exited.
LAYER_ZERO_RESTART_DELAY_MS=3000

LOG_LEVEL=info

# Docker executable. Set to "sudo docker" only on hosts where the invoking
# user is not in the docker group.
DOCKER_BINARY=docker

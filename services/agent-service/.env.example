# Firestore emulator (leave set for local development).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=acn-local

# Server-side only. Copy this file to .env and replace the placeholder.
# Never expose this key to apps/web or commit it.
OPENAI_API_KEY=sk-your-openai-api-key-here

# GPT-5.6 Luna supports none|low|medium|high|xhigh|max. Low is appropriate for
# this bounded, latency-sensitive investigation over pre-collected evidence.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=4096

LOG_LEVEL=info

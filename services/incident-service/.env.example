# Firestore emulator (leave set for local development).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=acn-local

# How long an incident stays open to absorb related events.
INCIDENT_CORRELATION_WINDOW_MS=120000

# Quiet period before a root cause is treated as settled. Must be long enough
# for the far end of a link to corroborate, or every link failure is briefly
# misreported as a device failure.
INCIDENT_SETTLE_MS=10000

# How often incidents are re-evaluated and flushed.
INCIDENT_TICK_INTERVAL_MS=2000

# Correlate events already in Firestore instead of starting from now.
INCIDENT_REPLAY_HISTORY=false

LOG_LEVEL=info

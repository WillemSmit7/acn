# ACN Health Service configuration.
# Copy to .env and adjust. NEVER commit a real .env or any service-account key.

# --- Firebase -------------------------------------------------------------
# Firestore emulator host. Set this and the service talks to the local
# emulator with dummy credentials. UNSET IT and the service talks to real
# Firebase using Application Default Credentials.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=acn-local

# --- Health checking ------------------------------------------------------
# Seconds between check rounds.
HEALTH_CHECK_INTERVAL_SECONDS=30
# Seconds to wait for a single ICMP echo reply before calling it a failure.
HEALTH_CHECK_TIMEOUT_SECONDS=2
# ICMP echo requests sent per check. A device is healthy if at least one replies.
HEALTH_CHECK_PING_COUNT=2

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
